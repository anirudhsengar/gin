      "invariants": [
        {
          "rule": "Every body decoder returns decoder errors before invoking the shared validate function.",
          "why": "Malformed input and destination validation are distinct failure stages.",
          "reference": "binding/xml.go"
        },
        {
          "rule": "BindingBody implementations support both request streams and supplied byte bodies.",
          "why": "Context shortcuts and body-reuse APIs depend on both entry paths.",
          "reference": "binding/msgpack.go"
        },
        {
          "rule": "Validator skips nil/non-struct values, recursively validates slices/arrays, and initializes the engine once with the binding tag.",
          "why": "This is the StructValidator contract documented by the binding package.",
          "reference": "binding/default_validator.go"
        },
        {
          "rule": "SliceValidationError preserves element indexes and omits nil errors from its string form.",
          "why": "Callers need stable, actionable validation diagnostics.",
          "reference": "binding/default_validator_test.go"
        }
      ],
      "pitfalls": [
        {
          "risk": "Adding a MIME mapping without implementing both BindingBody paths or a matching test.",
          "consequence": "Automatic binding and explicit Bind* shortcuts can diverge.",
          "reference": "binding/binding.go"
        },
        {
          "risk": "Bypassing validate after a decoder succeeds.",
          "consequence": "binding tags stop enforcing request invariants for that format.",
          "reference": "binding/yaml.go"
        },
        {
          "risk": "Changing pointer/slice recursion or sync.Once initialization.",
          "consequence": "Valid request shapes may be skipped or validator configuration may race or drift.",
          "reference": "binding/default_validator.go"
        }
      ],
      "entry_questions": [
        "Does a decoder error remain distinct from a validation error?",
        "Does the format support both request and byte-body binding?",
        "Is the change in MIME selection, decoding, or shared validation?",
        "Will pointer, slice, and array destinations retain the StructValidator contract?"
      ],
