    "payload": {
      "specialist_id": "specialist-multi-format-request-binding-and-validation",
      "concern": "Multi-format request binding and validation",
      "one_line": "Owns content-type binding selection, decoder-specific request/body binding for non-JSON formats, lazy default validation, and the validation error contract.",
      "covers": "binding.Binding and BindingBody selection, MsgPack/TOML/XML/YAML decoders, defaultValidator traversal and initialization, and their implementation tests.",
      "excludes": "The pluggable JSON codec backend seam, form/query mapping internals, and deprecated API forwarding.",
      "flows": [
        {
          "name": "Content type to decoded and validated object",
          "description": "Context chooses a binding, the format implementation decodes into the destination, and the shared validator checks it.",
          "steps": [
            {
              "path": "context.go",
              "what_happens": "Bind and ShouldBind choose binding.Default from request method and Content-Type, while format-specific shortcuts call MustBindWith."
            },
            {
              "path": "binding/binding.go",
              "what_happens": "Default maps XML, MsgPack, YAML, and TOML MIME values to their BindingBody implementations."
            },
            {
              "path": "binding/msgpack.go",
              "what_happens": "msgpackBinding decodes request/body bytes with codec.MsgpackHandle and then calls validate."
            },
            {
              "path": "binding/toml.go",
              "what_happens": "tomlBinding decodes with toml.NewDecoder and then calls validate."
            },
            {
              "path": "binding/xml.go",
              "what_happens": "xmlBinding decodes with encoding/xml.Decoder and then calls validate."
            },
            {
              "path": "binding/yaml.go",
              "what_happens": "yamlBinding decodes with yaml.NewDecoder and then calls validate."
            },
            {
              "path": "binding/default_validator.go",
              "what_happens": "validate reaches the configured StructValidator, which lazily initializes validator.v10 and validates the destination."
            },
            {
              "path": "binding/msgpack_test.go",
              "what_happens": "TestMsgpackBindingBindBody verifies a decoded MsgPack field."
            },
            {
              "path": "binding/toml_test.go",
              "what_happens": "TestTOMLBindingBindBody verifies a decoded TOML field."
            },
            {
              "path": "binding/xml_test.go",
              "what_happens": "TestXMLBindingBindBody verifies a decoded XML field."
            },
            {
              "path": "binding/yaml_test.go",
              "what_happens": "TestYAMLBindingBindBody verifies a decoded YAML field."
            }
          ]
        },
        {
          "name": "Recursive validation and stable error formatting",
          "description": "The default validator handles supported shapes and produces deterministic indexed errors while tests cover success and failure paths.",
          "steps": [
            {
              "path": "binding/default_validator.go",
              "what_happens": "ValidateStruct distinguishes nil, scalar, pointer, struct, slice, and array inputs and recursively validates elements."
            },
            {
              "path": "binding/default_validator.go",
              "what_happens": "SliceValidationError.Error formats non-nil element errors with their original indexes."
            },
            {
              "path": "binding/default_validator.go",
              "what_happens": "lazyinit uses sync.Once and configures the binding tag on validator.New."
            },
            {
              "path": "binding/default_validator_test.go",
              "what_happens": "Tests exercise nil/scalar/struct/pointer/slice forms and both validation outcomes, plus indexed error formatting."
            }
          ]
        }
      ],
