    "invariants": [
      {
        "rule": "Empty account sets or usernames panic during middleware construction.",
        "why": "Misconfiguration is surfaced before serving.",
        "reference": "auth.go"
      },
      {
        "rule": "Matching compares complete encoded values with ConstantTimeCompare.",
        "why": "Exact matching prevents false authorization.",
        "reference": "auth_test.go"
      },
      {
        "rule": "Failure aborts the chain and emits its challenge/status pair.",
        "why": "Unauthenticated handlers must not execute.",
        "reference": "auth.go"
      },
      {
        "rule": "Success exposes the principal through AuthUserKey or AuthProxyUserKey.",
        "why": "Those keys are the downstream contract.",
        "reference": "auth.go"
      }
    ],
    "pitfalls": [
      {
        "risk": "Mutating Accounts after installing middleware.",
        "consequence": "Captured pairs do not reflect runtime rotations.",
        "reference": "auth.go"
      },
      {
        "risk": "Treating an authenticated key as authorization.",
        "consequence": "Identity is accepted without route-specific permission checks.",
        "reference": "auth.go"
      },
      {
        "risk": "Changing realm quoting or using prefix matching.",
        "consequence": "Challenge or exact rejection behavior drifts.",
        "reference": "auth_test.go"
