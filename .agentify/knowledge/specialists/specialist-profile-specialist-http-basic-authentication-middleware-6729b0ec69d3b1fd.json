  "payload": {
    "specialist_id": "specialist-http-basic-authentication-middleware",
    "concern": "HTTP Basic authentication middleware",
    "one_line": "Precomputes Basic credentials, compares authorization values in constant time, and stores the principal or aborts with the correct origin/proxy challenge.",
    "covers": "Account preprocessing, Base64 construction, matching, context keys, challenge headers, and 401/407 behavior.",
    "excludes": "Authorization policy, sessions/cookies/CSRF, Bearer/JWT, request-body binding, and client certificates.",
    "flows": [
      {
        "name": "Origin match or 401",
        "description": "Configured accounts become a credential table and requests receive a user key or are stopped.",
        "steps": [
          {
            "path": "auth.go",
            "what_happens": "BasicAuth normalizes realm and delegates to processAccounts."
          },
          {
            "path": "auth.go",
            "what_happens": "processAccounts validates accounts and precomputes encoded credentials."
          },
          {
            "path": "auth.go",
            "what_happens": "The handler reads Authorization and uses ConstantTimeCompare."
          },
          {
            "path": "context.go",
            "what_happens": "Success sets AuthUserKey; failure sets WWW-Authenticate and aborts with 401."
          },
          {
            "path": "auth_test.go",
            "what_happens": "Tests cover encoding, exact rejection, success storage, realm quoting, and chain stopping."
          }
        ]
      },
      {
        "name": "Proxy match or 407",
        "description": "The proxy variant uses a distinct header, key, challenge, and status.",
        "steps": [
          {
            "path": "auth.go",
            "what_happens": "BasicAuthForProxy selects its realm and captures processed pairs."
          },
          {
            "path": "auth.go",
            "what_happens": "Its handler compares Proxy-Authorization and stores AuthProxyUserKey."
          },
          {
            "path": "context.go",
            "what_happens": "Failure sets Proxy-Authenticate and aborts with 407."
          },
          {
            "path": "auth_test.go",
            "what_happens": "Proxy success and 407 tests verify the separate contract."
          }
        ]
      }
    ],
