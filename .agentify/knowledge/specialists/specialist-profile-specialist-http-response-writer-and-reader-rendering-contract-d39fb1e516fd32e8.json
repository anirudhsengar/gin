  "payload": {
    "specialist_id": "specialist-http-response-writer-and-reader-rendering-contract",
    "concern": "HTTP response writer and Reader rendering contract",
    "one_line": "Owns staged response status and size, header commitment, interface delegation, and render.Reader header/body copying.",
    "covers": "ResponseWriter and Reader behavior through Context/Gin integration and tests.",
    "excludes": "Routing, handler composition, logging/recovery, template/JSON serialization internals, and listener setup.",
    "flows": [
      {
        "name": "DataFromReader response",
        "description": "A reader response stages status, writes headers, commits on body copy, and is finalized by the engine.",
        "steps": [
          {
            "path": "context.go",
            "what_happens": "DataFromReader constructs render.Reader and calls Render."
          },
          {
            "path": "render/reader.go",
            "what_happens": "Reader.Render writes Content-Type and missing headers, adds Content-Length, and calls io.Copy."
          },
          {
            "path": "response_writer.go",
            "what_happens": "responseWriter.Write commits headers before forwarding bytes and increments size."
          },
          {
            "path": "gin.go",
            "what_happens": "handleHTTPRequest performs final WriteHeaderNow for empty responses."
          }
        ]
      },
      {
        "name": "Hijack and streaming lifecycle",
        "description": "The wrapper preserves safe fallbacks and header-before-body behavior.",
        "steps": [
          {
            "path": "response_writer.go",
            "what_happens": "Hijack rejects body-written responses and delegates or returns ErrNotSupported."
          },
          {
            "path": "response_writer_test.go",
            "what_happens": "Tests pin status, size, flush, and hijack transitions."
          },
          {
            "path": "render/reader.go",
            "what_happens": "writeHeaders preserves existing header overrides."
          },
          {
            "path": "render/reader_test.go",
            "what_happens": "Reader rendering succeeds without an optional Headers map."
          }
        ]
      }
    ],
