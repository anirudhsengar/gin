    "invariants": [
      {
        "rule": "WriteHeader stages status and WriteHeaderNow commits once; body writes and Flush commit first.",
        "why": "Renderers need a header window after status staging.",
        "reference": "response_writer.go"
      },
      {
        "rule": "Reader emits Content-Length only for non-negative lengths and only fills absent headers.",
        "why": "Unknown lengths remain unset and overrides survive.",
        "reference": "render/reader.go"
      },
      {
        "rule": "Hijack is allowed before body bytes and unsupported writers return ErrNotSupported.",
        "why": "This preserves websocket compatibility and normal fallback.",
        "reference": "response_writer.go"
      }
    ],
    "pitfalls": [
      {
        "risk": "Treating Status as an immediate commit.",
        "consequence": "Header ordering becomes incorrect.",
        "reference": "response_writer.go"
      },
      {
        "risk": "Reusing Reader.Headers across renders.",
        "consequence": "Content-Length mutation can race.",
        "reference": "render/reader.go"
      },
      {
        "risk": "Assuming every writer supports Hijacker or Flusher.",
        "consequence": "Streaming or fallback behavior changes.",
        "reference": "response_writer.go"
      }
    ],
    "entry_questions": [
      "Can the writer lack Hijacker or Flusher?",
      "Does the change occur before final WriteHeaderNow?",
      "Is content length known?"
    ],
