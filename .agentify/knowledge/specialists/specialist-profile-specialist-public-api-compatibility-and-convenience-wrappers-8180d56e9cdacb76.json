        "reference": "ginS/gins.go"
      },
      {
        "rule": "Legacy Engine.AppEngine remains a soft migration surface until deliberately removed.",
        "why": "Existing deployments may rely on its fallback.",
        "reference": "gin.go"
      }
    ],
    "pitfalls": [
      {
        "risk": "Changing BindWith to implicit binding selection.",
        "consequence": "Explicit-binding callers receive different parsing behavior.",
        "reference": "deprecated.go"
      },
      {
        "risk": "Resetting ginS state or adding wrapper logic.",
        "consequence": "Shared-engine parity drifts.",
        "reference": "ginS/gins_test.go"
      },
      {
        "risk": "Removing AppEngine fallback while retaining its marker.",
        "consequence": "Legacy deployments lose trusted-platform behavior.",
        "reference": "gin.go"
      }
    ],
