    "invariants": [
      {
        "rule": "BindWith remains a logging synonym for MustBindWith and preserves the explicit Binding argument.",
        "why": "Existing callers rely on this migration path.",
        "reference": "deprecated.go"
      },
      {
        "rule": "ginS constructs one gin.Default Engine and wrappers add no independent behavior.",
