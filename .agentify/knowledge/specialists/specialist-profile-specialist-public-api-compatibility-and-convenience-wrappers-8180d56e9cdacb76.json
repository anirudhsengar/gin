  "payload": {
    "specialist_id": "specialist-public-api-compatibility-and-convenience-wrappers",
    "concern": "Public API compatibility and convenience wrappers",
    "one_line": "Owns the deprecated BindWith forwarding contract and the ginS package-level facade that lazily forwards calls to one default Engine.",
    "covers": "BindWith migration logging and forwarding, legacy Engine.AppEngine compatibility, ginS sync.OnceValue state, wrapper forwarding, and tests.",
    "excludes": "Binding implementation semantics, route-trie mechanics, general lifecycle, middleware behavior, and authentication.",
    "flows": [
      {
        "name": "Deprecated BindWith forwarding",
        "description": "The legacy API logs guidance and forwards into the current explicit-binding path.",
        "steps": [
          {
            "path": "deprecated.go",
            "what_happens": "Context.BindWith logs the issue-662 notice and calls MustBindWith."
          },
          {
            "path": "context.go",
            "what_happens": "MustBindWith delegates to ShouldBindWith and invokes the supplied Binding."
          },
          {
            "path": "binding/binding.go",
            "what_happens": "The selected Binding receives the request and destination."
          },
          {
            "path": "deprecated_test.go",
            "what_happens": "TestBindWith captures the notice and verifies Form results."
          }
        ]
      },
      {
        "name": "ginS lazy facade forwarding",
        "description": "Package helpers share one lazily created gin.Default Engine and forward calls to it.",
        "steps": [
          {
            "path": "ginS/gins.go",
            "what_happens": "sync.OnceValue creates one gin.Default Engine on first use."
          },
          {
            "path": "ginS/gins.go",
            "what_happens": "GET, POST, Use, NoRoute, Static, and Run call engine().X."
          },
          {
            "path": "gin.go",
            "what_happens": "The target Engine and embedded RouterGroup implement forwarded operations."
          },
          {
            "path": "ginS/gins_test.go",
            "what_happens": "Wrapper tests register routes and serve requests through the cached engine."
          }
        ]
      }
    ],
