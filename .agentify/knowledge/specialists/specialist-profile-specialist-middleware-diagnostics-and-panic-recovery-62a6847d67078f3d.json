  "payload": {
    "specialist_id": "specialist-middleware-diagnostics-and-panic-recovery",
    "concern": "Middleware diagnostics and panic recovery",
    "one_line": "Owns debug-print gating, access-log formatting, panic recovery, broken-pipe handling, and Authorization redaction across built-in middleware.",
    "covers": "Debug hooks, Logger constructors/formatters/skips, Recovery handlers/request dumps, and exact tests.",
    "excludes": "Context handler-chain/error storage mechanics, route-trie correctness, authentication policy, and listener lifecycle.",
    "flows": [
      {
        "name": "Debug lifecycle diagnostics",
        "description": "Route/template lifecycle events share the mode-gated diagnostic pipeline.",
        "steps": [
          {
            "path": "gin.go",
            "what_happens": "Route registration and template loading invoke debug helpers."
          },
          {
            "path": "debug.go",
            "what_happens": "debugPrint selects the hook or [GIN-debug] output."
          },
          {
            "path": "debug_test.go",
            "what_happens": "Tests assert non-debug silence, hooks, warnings, route/template output, and capture."
          }
        ]
      },
      {
        "name": "Default middleware observability",
        "description": "Default wires Logger and Recovery and Logger observes the post-handler response.",
        "steps": [
          {
            "path": "gin.go",
            "what_happens": "Default creates New and attaches Logger before Recovery."
          },
          {
            "path": "debug.go",
            "what_happens": "IsDebugging gates warnings, route/template diagnostics, and hooks."
          },
          {
            "path": "logger.go",
            "what_happens": "Logger times c.Next and formats status, latency, client IP, errors, keys, and body size."
          },
          {
            "path": "logger_test.go",
            "what_happens": "Tests cover constructors, formatting, colors, skips, query suppression, and ErrorLogger."
          }
        ]
      },
      {
        "name": "Panic safety and sanitized diagnostics",
        "description": "Recovery classifies panics and masks Authorization in diagnostics.",
        "steps": [
          {
            "path": "recovery.go",
            "what_happens": "Recovery defers recover around c.Next and classifies broken-pipe sentinels."
          },
          {
            "path": "recovery.go",
            "what_happens": "Normal panics log and invoke recovery; broken pipes record and abort without status."
          },
          {
            "path": "debug.go",
            "what_happens": "The debug gate controls recovery diagnostic detail."
          },
          {
            "path": "recovery_test.go",
            "what_happens": "Tests pin 500/custom recovery, broken pipes, dumps, stack helpers, and masking."
          }
        ]
      }
    ],
