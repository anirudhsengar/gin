    "invariants": [
      {
        "rule": "Logger captures path before c.Next and status/errors/body state after it; Default installs Logger before Recovery.",
        "why": "The log must see the recovered final status.",
        "reference": "logger.go"
      },
      {
        "rule": "Recovery treats EPIPE, ECONNRESET, and http.ErrAbortHandler as broken pipes without writing status.",
        "why": "A dead client cannot receive a 500.",
        "reference": "recovery.go"
      },
      {
        "rule": "secureRequestDump masks Authorization lines and debugPrint is silent outside debug mode.",
        "why": "Diagnostics avoid credential leakage and release noise.",
        "reference": "recovery.go"
      }
    ],
    "pitfalls": [
      {
        "risk": "Reordering Logger and Recovery.",
        "consequence": "Access logs can record the wrong panic status.",
        "reference": "gin.go"
      },
      {
        "risk": "Handling broken pipes as ordinary panics.",
        "consequence": "Recovery attempts a dead-socket write.",
        "reference": "recovery.go"
      },
      {
        "risk": "Treating SkipPaths as prefix matches.",
        "consequence": "Variants continue to be logged.",
        "reference": "logger.go"
      }
    ],
    "entry_questions": [
      "Can the panic be a broken-pipe sentinel?",
      "Does middleware ordering remain Logger around Recovery?",
      "Must the diagnostic remain silent outside debug mode?"
    ],
