    "invariants": [
      {
        "rule": "The wildcard child remains final and node priority accounts for descendants and its own handler.",
        "why": "Lookup and priority reordering rely on this convention.",
        "reference": "tree.go"
      },
      {
        "rule": "Registration precedes serving and is not concurrency-safe.",
        "why": "Trie mutation and one-shot route updates are unprotected.",
        "reference": "gin.go"
      },
      {
        "rule": "Fallback order is trailing-slash, fixed-path, method-not-allowed, then not-found.",
        "why": "The order is externally visible.",
        "reference": "gin.go"
      },
      {
        "rule": "UseEscapedPath overrides UseRawPath and affects parameter unescaping.",
        "why": "The engine chooses path representation before lookup.",
        "reference": "gin.go"
      }
    ],
    "pitfalls": [
      {
        "risk": "Registering literal-colon routes after the one-shot route update.",
        "consequence": "New escaped paths can fail to match.",
        "reference": "gin.go"
      },
      {
        "risk": "Changing wildcard ordering or skipped-node rollback.",
        "consequence": "Greedy parameters can shadow static routes.",
        "reference": "tree.go"
      },
      {
        "risk": "Changing joinPaths or safeUint16 without updating pool assumptions.",
        "consequence": "Nested paths or parameter buffers become incorrect.",
        "reference": "utils.go"
      }
    ],
