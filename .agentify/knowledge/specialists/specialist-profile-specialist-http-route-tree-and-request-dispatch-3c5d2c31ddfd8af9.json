  "payload": {
    "specialist_id": "specialist-http-route-tree-and-request-dispatch",
    "concern": "HTTP route tree and request dispatch",
    "one_line": "Owns route registration into per-method radix trees and request-time matching, parameter extraction, handler selection, and redirect/error fallback.",
    "covers": "Engine registration and ServeHTTP dispatch, RouterGroup path composition, trie insertion/lookup, and route helper tests.",
    "excludes": "Middleware semantics, static-file internals, trusted-proxy extraction, renderer implementations, and listener lifecycle.",
    "flows": [
      {
        "name": "Request dispatch and fallback",
        "description": "The engine resolves a URL and runs the handler or miss fallback.",
        "steps": [
          {
            "path": "gin.go",
            "what_happens": "ServeHTTP resets a pooled Context and calls handleHTTPRequest."
          },
          {
            "path": "tree.go",
            "what_happens": "node.getValue walks edges and returns handlers, Params, fullPath, and TSR hints."
          },
          {
            "path": "gin.go",
            "what_happens": "handleHTTPRequest chooses redirect, 405, or 404 behavior."
          },
          {
            "path": "gin_test.go",
            "what_happens": "Engine tests pin redirects, registration failures, re-entry, literal-colon updates, and route listing."
          }
        ]
      },
      {
        "name": "Route registration",
        "description": "Verbs compose paths and handlers before attaching them to a method trie.",
        "steps": [
          {
            "path": "routergroup.go",
            "what_happens": "RouterGroup verbs calculate absolute paths and combine handlers."
          },
          {
            "path": "gin.go",
            "what_happens": "Engine.addRoute validates inputs and sizes pooled context buffers."
          },
          {
            "path": "tree.go",
            "what_happens": "node.addRoute splits prefixes and inserts static, parameter, or catch-all nodes."
          },
          {
            "path": "utils.go",
            "what_happens": "joinPaths and safeUint16 support path composition and sizing."
          }
        ]
      }
    ],
