  "payload": {
    "specialist_id": "specialist-pluggable-json-codec-via-build-tag-selected-backends",
    "concern": "Pluggable JSON codec via build-tag-selected backends",
    "one_line": "The codec/json Core seam selects one JSON backend at build time and routes JSON binding, rendering, form coercion, and error marshaling through a mutable package API.",
    "covers": "codec/json interfaces, build-tag backends, decoder facade, and downstream JSON consumers.",
    "excludes": "Non-JSON codecs, external dependency internals, and ginS.",
    "flows": [
      {
        "name": "JSON decode through selected backend",
        "description": "Binding reaches the active backend and validation.",
        "steps": [
          {
            "path": "context.go",
            "what_happens": "BindJSON and MustBindWith enter binding.JSON."
          },
          {
            "path": "binding/json.go",
            "what_happens": "decodeJSON obtains json.API.NewDecoder, applies decoder flags, decodes, and validates."
          },
          {
            "path": "codec/json/api.go",
            "what_happens": "Core and Decoder define the swap contract."
          },
          {
            "path": "codec/json/json.go",
            "what_happens": "The default build-tag backend initializes API."
          }
        ]
      },
      {
        "name": "JSON encode and runtime swap",
        "description": "Renderers and errors use the same API seam.",
        "steps": [
          {
            "path": "render/json.go",
            "what_happens": "JSON renderers call API marshal and encoder methods."
          },
          {
            "path": "errors.go",
            "what_happens": "Error envelopes marshal through API.Marshal."
          },
          {
            "path": "binding/json_test.go",
            "what_happens": "The custom codec test swaps API and exercises decode and encode."
          }
        ]
      }
    ],
